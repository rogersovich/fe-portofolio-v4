    "@primeuix/themes": "^1.0.3",
    "@tabler/icons-vue": "^3.31.0",
    "@vueuse/components": "^12.2.0",
    "@vueuse/core": "^12.2.0",
    "@vueuse/motion": "^2.2.6",
    "@vueuse/nuxt": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "highlight.js": "^11.11.1",
    "nuxt": "^3.21.11",
    "nuxt-umami": "^3.2.0",
    "pinia": "^3.0.2",
    "primeicons": "^7.0.0",
